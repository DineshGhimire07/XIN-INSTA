# ==========================================
# APP & ENVIRONMENT
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte hex key for AES-256-GCM token encryption (generate with: openssl rand -hex 32)
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==========================================
# SUPABASE POSTGRESQL DATABASE
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ==========================================
# META DEVELOPER APP CREDENTIALS
# ==========================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret_hex
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token
META_GRAPH_API_VERSION=v19.0

# ==========================================
# QUEUE & DISPATCHER ENGINE
# ==========================================
MAX_OUTBOUND_RATE_PER_MIN=120
QUEUE_CONCURRENCY=5
RETRY_MAX_ATTEMPTS=3
